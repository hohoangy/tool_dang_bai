{
  "name": "ai-social-automation-saas",
  "version": "1.0.0",
  "private": true,
  "description": "AI Social Media Automation SaaS monorepo",
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "ld:helper": "node tools/ld-runtime-helper.mjs",
    "ld:diagnose": "node tools/ldplayer-baseline-diagnose.mjs --baseline=1 --indexes=0,1,2",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "stress:fb-review": "node tools/mobile-facebook-review-stress.mjs",
    "test:bulk-queue": "node tools/mobile-bulk-queue-sim.mjs",
    "test:bulk-queue:stress": "node tools/mobile-bulk-queue-sim.mjs --iterations=20000 --seed=20260722",
    "test:mobile-error-classify": "node tools/mobile-publish-error-classify-sim.mjs",
    "test:post-run-format": "node tools/mobile-post-run-format-sim.mjs",
    "test:mobile-offline:local": "npm-run-all test:post-run-format test:mobile-error-classify test:bulk-queue test:ig-review-matrix:local",
    "test:mobile-offline": "npm-run-all test:post-run-format test:mobile-error-classify test:bulk-queue:stress test:ig-review-matrix test:ig-submit-matrix test:ig-gate-matrix",
    "test:ig-review-matrix:local": "node tools/mobile-instagram-review-stress.mjs --locales vi --resolutions 900x1600 --scenarios single-photo:1,album-2:1,system-ui-once:1 --iterations=20 --concurrency=1 --maxFailures=0 --minRate=0.5 --maxP95Ms=6500 --maxP99Ms=7500",
    "test:fb-review-matrix": "node tools/mobile-facebook-review-stress.mjs --locales vi,en --resolutions 720x1280,900x1600,1080x1920 --scenarios text:1,collage:1,video:1,share-chooser:1,system-ui-once:1",
    "test:ig-review-matrix": "node tools/mobile-instagram-review-stress.mjs --locales vi,en --resolutions 720x1280,900x1600,1080x1920 --scenarios single-photo:1,album-2:1,album-4:1,empty-caption:1,system-ui-once:1 --iterations=1000 --concurrency=25 --maxFailures=0 --minRate=8 --maxP95Ms=4500 --maxP99Ms=5200",
    "test:ig-submit-matrix": "node tools/mobile-instagram-review-stress.mjs --mode=submit --locales vi,en --resolutions 720x1280,900x1600,1080x1920 --scenarios single-photo:1,album-2:1,album-4:1,empty-caption:1,system-ui-once:1,submit-unverified:1 --iterations=120 --concurrency=12 --maxFailures=0 --minRate=6 --maxP95Ms=5200 --maxP99Ms=6200",
    "test:ig-gate-matrix": "node tools/mobile-instagram-review-stress.mjs --mode=submit --locales vi,en --resolutions 720x1280,900x1600,1080x1920 --scenarios gate-no-share:1,gate-no-media:1 --iterations=60 --concurrency=10 --maxFailures=0 --minRate=6 --maxP95Ms=5200 --maxP99Ms=6200",
    "test:ld-instagram-open": "node tools/mobile-instagram-open-sequential.mjs --caseTimeoutMs 240000 --coolDownMs 15000",
    "test:ld-safe": "npm-run-all test:mobile-offline:local test:ld-instagram-open",
    "test:ld-facebook-review": "node tools/mobile-facebook-review-real.mjs",
    "test:ig-review-real": "node tools/mobile-instagram-review-real.mjs",
    "test:fb-review-real": "node tools/mobile-facebook-review-batch-real.mjs",
    "test:fb-smoke-real": "node tools/mobile-facebook-smoke-real.mjs",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
